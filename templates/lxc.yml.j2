---
apiVersion: lxc.shm.dev/v1alpha1
kind: Application
metadata:
  name: {{ svc_wordpress_name }}
spec:
  replicas: {{ svc_wordpress_replicas }}
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ svc_wordpress_name }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ svc_wordpress_name }}
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: {{ svc_wordpress_user }}
        runAsGroup: {{ svc_wordpress_group }}
        fsGroup: {{ svc_wordpress_group }}
      containers:
        - name: {{ svc_wordpress_name }}
          image: {{ svc_wordpress_image }}
          imagePullPolicy: {{ svc_wordpress_image_pull_policy }}
          securityContext:
            readOnlyRootFilesystem: {{ svc_wordpress_read_only_rootfs | bool | lower }}
            allowPrivilegeEscalation: false
            privileged: {{ svc_wordpress_allow_privileged | bool | lower }}
            capabilities:
              drop: {{ svc_wordpress_drop_capabilities }}
          env:
            {% set _resolved_db_host = svc_wordpress_db_host | default('', true) %}
            {% if not _resolved_db_host and (DATABASE_HOST is defined) %}
            {% set _resolved_db_host = DATABASE_HOST | default('', true) %}
            {% endif %}
            {% set _resolved_db_port = svc_wordpress_db_port | default('', true) %}
            {% if not (_resolved_db_port | string | length) and (DATABASE_PORT is defined) %}
            {% set _resolved_db_port = DATABASE_PORT | default('', true) %}
            {% endif %}
            - name: WORDPRESS_DB_HOST
              value: "{{ _resolved_db_host }}{% if _resolved_db_port %}:{{ _resolved_db_port }}{% endif %}"
            - name: WORDPRESS_DB_NAME
              value: "{{ svc_wordpress_db_name }}"
            - name: WORDPRESS_DB_USER
              value: "{{ svc_wordpress_db_user }}"
            - name: WORDPRESS_DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ svc_wordpress_name }}-db
                  key: password
            - name: WORDPRESS_CONFIG_EXTRA
              value: |
                if (file_exists('{{ svc_wordpress_salts_mount_path }}/wp-salts.php')) {
                  require_once '{{ svc_wordpress_salts_mount_path }}/wp-salts.php';
                }
                define('WP_HOME', '{{ svc_wordpress_url }}');
                define('WP_SITEURL', '{{ svc_wordpress_url }}');
                define('FORCE_SSL_ADMIN', true);
                if (!defined('DISALLOW_FILE_EDIT')) {
                  define('DISALLOW_FILE_EDIT', true);
                }
                $httpsDetected = false;
                if (isset($_SERVER['HTTP_X_FORWARDED_PROTO'])) {
                  $forwardedProto = explode(',', $_SERVER['HTTP_X_FORWARDED_PROTO'])[0];
                  if (stripos($forwardedProto, 'https') !== false) {
                    $_SERVER['HTTPS'] = 'on';
                    $_SERVER['SERVER_PORT'] = 443;
                    $httpsDetected = true;
                  }
                }
                if (isset($_SERVER['HTTP_X_FORWARDED_HOST'])) {
                  $_SERVER['HTTP_HOST'] = $_SERVER['HTTP_X_FORWARDED_HOST'];
                }
                if (!$httpsDetected && (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off')) {
                  $_SERVER['SERVER_PORT'] = 443;
                }
                if (isset($_SERVER['SCRIPT_NAME']) && basename($_SERVER['SCRIPT_NAME']) === 'xmlrpc.php') {
                  header('HTTP/1.1 403 Forbidden');
                  exit;
                }
                {% if not svc_wordpress_wp_cli_auto_updates %}
                define('AUTOMATIC_UPDATER_DISABLED', true);
                define('WP_AUTO_UPDATE_CORE', false);
                {% endif %}
                {% if svc_wordpress_enable_object_cache %}
                define('WP_CACHE', true);
                define('WP_REDIS_SCHEME', '{{ 'tls' if svc_wordpress_redis_use_tls else 'tcp' }}');
                {% if svc_wordpress_redis_use_tls %}
                define('WP_REDIS_SSL_CONTEXT_OPTIONS', [
                  'verify_peer' => {{ 'true' if svc_wordpress_redis_verify_peer else 'false' }},
                  {% if svc_wordpress_redis_verify_peer %}
                  'cafile' => '{{ svc_wordpress_redis_tls_ca_mount_path }}',
                  {% endif %}
                ]);
                {% endif %}
                {% endif %}
                {% if svc_wordpress_enable_object_storage %}
                define('S3_UPLOADS_BUCKET', getenv('S3_UPLOADS_BUCKET'));
                define('S3_UPLOADS_REGION', getenv('S3_UPLOADS_REGION'));
                define('S3_UPLOADS_KEY', trim(file_get_contents('{{ svc_wordpress_object_storage_credentials_mount_path }}/access_key')));
                define('S3_UPLOADS_SECRET', trim(file_get_contents('{{ svc_wordpress_object_storage_credentials_mount_path }}/secret_key')));
                {% endif %}
                {% if svc_wordpress_enable_multisite %}
                define('WP_ALLOW_MULTISITE', true);
                define('MULTISITE', true);
                define('SUBDOMAIN_INSTALL', {{ 'true' if svc_wordpress_multisite.subdomain_install else 'false' }});
                define('DOMAIN_CURRENT_SITE', '{{ svc_wordpress_multisite.site_domain }}');
                define('PATH_CURRENT_SITE', '{{ svc_wordpress_multisite.site_path }}');
                define('SITE_ID_CURRENT_SITE', {{ svc_wordpress_multisite.site_id }});
                define('BLOG_ID_CURRENT_SITE', {{ svc_wordpress_multisite.blog_id }});
                {% endif %}
                {{ svc_wordpress_extra_wordpress_config }}
            - name: WORDPRESS_DB_SSL
              value: "{{ '1' if svc_wordpress_db_use_tls else '0' }}"
            - name: WORDPRESS_MEMORY_LIMIT
              value: "{{ svc_wordpress_memory_limit }}"
            - name: PHP_MEMORY_LIMIT
              value: "{{ svc_wordpress_memory_limit }}"
            - name: WORDPRESS_MAX_UPLOAD_SIZE
              value: "{{ svc_wordpress_max_upload_size }}"
            - name: WORDPRESS_CONFIG_PERMALINK_STRUCTURE
              value: '/%year%/%monthnum%/%postname%/'
            - name: WORDPRESS_AUTO_UPDATE_CORE
              value: "{{ 'true' if svc_wordpress_wp_cli_auto_updates else 'false' }}"
            - name: WORDPRESS_URL
              value: "{{ svc_wordpress_url }}"
            {% if svc_wordpress_enable_object_cache %}
            - name: WP_REDIS_HOST
              value: "{{ svc_wordpress_redis_host }}"
            - name: WP_REDIS_PORT
              value: "{{ svc_wordpress_redis_port }}"
            - name: WP_REDIS_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ svc_wordpress_name }}-redis
                  key: password
            - name: WP_REDIS_SCHEME
              value: "{{ 'tls' if svc_wordpress_redis_use_tls else 'tcp' }}"
            {% endif %}
            {% if svc_wordpress_enable_object_storage %}
            - name: S3_UPLOADS_BUCKET
              value: "{{ svc_wordpress_object_storage_bucket }}"
            - name: S3_UPLOADS_REGION
              value: "{{ svc_wordpress_object_storage_region }}"
            {% endif %}
            {% for key, value in svc_wordpress_extra_environment.items() %}
            - name: {{ key }}
              value: "{{ value }}"
            {% endfor %}
          {% if svc_wordpress_env_secret_name %}
          envFrom:
            - secretRef:
                name: {{ svc_wordpress_env_secret_name }}
          {% endif %}
          ports:
            - name: http
              containerPort: 80
          readinessProbe:
            exec:
              command:
                - /bin/sh
                - -c
                - >-
                  curl --fail --silent --show-error http://127.0.0.1:{{ svc_wordpress_readiness_port }}{{ svc_wordpress_readiness_path }}
            initialDelaySeconds: {{ svc_wordpress_readiness_initial_delay }}
            periodSeconds: {{ svc_wordpress_readiness_interval }}
            timeoutSeconds: {{ svc_wordpress_readiness_timeout }}
            failureThreshold: {{ svc_wordpress_readiness_failure_threshold }}
            successThreshold: {{ svc_wordpress_readiness_success_threshold }}
          livenessProbe:
            exec:
              command:
                - /bin/sh
                - -c
                - >-
                  curl --fail --silent --show-error http://127.0.0.1:{{ svc_wordpress_readiness_port }}{{ svc_wordpress_liveness_path }}
            initialDelaySeconds: {{ svc_wordpress_liveness_initial_delay }}
            periodSeconds: {{ svc_wordpress_liveness_interval }}
            timeoutSeconds: {{ svc_wordpress_liveness_timeout }}
            failureThreshold: {{ svc_wordpress_liveness_failure_threshold }}
          startupProbe:
            httpGet:
              path: {{ svc_wordpress_startup_path }}
              port: {{ svc_wordpress_readiness_port }}
              scheme: HTTP
            initialDelaySeconds: {{ svc_wordpress_startup_initial_delay }}
            periodSeconds: {{ svc_wordpress_startup_interval }}
            timeoutSeconds: {{ svc_wordpress_startup_timeout }}
            failureThreshold: {{ svc_wordpress_startup_failure_threshold }}
          volumeMounts:
            - name: uploads
              mountPath: {{ svc_wordpress_uploads_path }}
            - name: wordpress-salts
              mountPath: {{ svc_wordpress_salts_mount_path }}
              readOnly: true
            {% if svc_wordpress_extra_php_ini %}
            - name: php-extra-config
              mountPath: /usr/local/etc/php/conf.d/zz-custom.ini
              subPath: custom.ini
            {% endif %}
            {% if svc_wordpress_enable_object_storage %}
            - name: object-storage-credentials
              mountPath: {{ svc_wordpress_object_storage_credentials_mount_path }}
              readOnly: true
            {% endif %}
            {% if svc_wordpress_enable_object_cache and svc_wordpress_redis_use_tls and svc_wordpress_redis_tls_secret %}
            - name: redis-ca
              mountPath: {{ svc_wordpress_redis_tls_ca_mount_dir }}
              readOnly: true
            {% endif %}
            {% if svc_wordpress_mu_plugins %}
            - name: mu-plugins
              mountPath: /var/www/html/wp-content/mu-plugins
              readOnly: true
            {% endif %}
            {% for path in svc_wordpress_tmpfs_paths %}
            - name: tmpfs-{{ loop.index }}
              mountPath: {{ path }}
            {% endfor %}
      volumes:
        - name: uploads
          persistentVolumeClaim:
            claimName: {{ svc_wordpress_name }}-uploads
        {% if svc_wordpress_extra_php_ini %}
        - name: php-extra-config
          configMap:
            name: {{ svc_wordpress_name }}-php-config
        {% endif %}
        - name: wordpress-salts
          secret:
            secretName: {{ svc_wordpress_name }}-auth
        {% if svc_wordpress_enable_object_storage %}
        - name: object-storage-credentials
          secret:
            secretName: {{ svc_wordpress_name }}-object-storage
        {% endif %}
        {% if svc_wordpress_enable_object_cache and svc_wordpress_redis_use_tls and svc_wordpress_redis_tls_secret %}
        - name: redis-ca
          secret:
            secretName: {{ svc_wordpress_redis_tls_secret }}
        {% endif %}
        {% if svc_wordpress_mu_plugins %}
        - name: mu-plugins
          configMap:
            name: {{ svc_wordpress_name }}-mu-plugins
        {% endif %}
        {% for path in svc_wordpress_tmpfs_paths %}
        - name: tmpfs-{{ loop.index }}
          emptyDir:
            medium: Memory
        {% endfor %}
{% if svc_wordpress_enable_object_storage %}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ svc_wordpress_name }}-object-storage
type: Opaque
stringData:
  access_key: "{{ svc_wordpress_object_storage_access_key }}"
  secret_key: "{{ svc_wordpress_object_storage_secret_key }}"
{% endif %}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ svc_wordpress_name }}-uploads
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: {{ svc_wordpress_uploads_size }}
  {% if svc_wordpress_uploads_storage_class %}
  storageClassName: {{ svc_wordpress_uploads_storage_class }}
  {% endif %}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ svc_wordpress_name }}
  annotations:
    nginx.ingress.kubernetes.io/backend-protocol: "HTTP"
    nginx.ingress.kubernetes.io/force-ssl-redirect: "true"
    nginx.ingress.kubernetes.io/proxy-body-size: "{{ svc_wordpress_max_upload_size }}"
{% for key, value in svc_wordpress_ingress_annotations.items() %}
    {{ key }}: "{{ value }}"
{% endfor %}
  {% if svc_wordpress_ingress_class_name %}
  ingressClassName: {{ svc_wordpress_ingress_class_name }}
  {% endif %}
spec:
  {% if svc_wordpress_ingress_tls_secret %}
  tls:
    - hosts:
        - {{ svc_wordpress_ingress_hostname }}
      secretName: {{ svc_wordpress_ingress_tls_secret }}
  {% endif %}
  rules:
    - host: {{ svc_wordpress_ingress_hostname }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ svc_wordpress_name }}
                port:
                  name: http
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ svc_wordpress_name }}-db
type: Opaque
stringData:
  password: "{{ svc_wordpress_db_password }}"
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ svc_wordpress_name }}-redis
type: Opaque
stringData:
  password: "{{ svc_wordpress_redis_password }}"
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ svc_wordpress_name }}-auth
type: Opaque
stringData:
  AUTH_KEY: "{{ svc_wordpress_auth_keys.AUTH_KEY }}"
  SECURE_AUTH_KEY: "{{ svc_wordpress_auth_keys.SECURE_AUTH_KEY }}"
  LOGGED_IN_KEY: "{{ svc_wordpress_auth_keys.LOGGED_IN_KEY }}"
  NONCE_KEY: "{{ svc_wordpress_auth_keys.NONCE_KEY }}"
  AUTH_SALT: "{{ svc_wordpress_auth_keys.AUTH_SALT }}"
  SECURE_AUTH_SALT: "{{ svc_wordpress_auth_keys.SECURE_AUTH_SALT }}"
  LOGGED_IN_SALT: "{{ svc_wordpress_auth_keys.LOGGED_IN_SALT }}"
  NONCE_SALT: "{{ svc_wordpress_auth_keys.NONCE_SALT }}"
  wp-salts.php: |-
    <?php
    define('AUTH_KEY', '{{ svc_wordpress_auth_keys.AUTH_KEY }}');
    define('SECURE_AUTH_KEY', '{{ svc_wordpress_auth_keys.SECURE_AUTH_KEY }}');
    define('LOGGED_IN_KEY', '{{ svc_wordpress_auth_keys.LOGGED_IN_KEY }}');
    define('NONCE_KEY', '{{ svc_wordpress_auth_keys.NONCE_KEY }}');
    define('AUTH_SALT', '{{ svc_wordpress_auth_keys.AUTH_SALT }}');
    define('SECURE_AUTH_SALT', '{{ svc_wordpress_auth_keys.SECURE_AUTH_SALT }}');
    define('LOGGED_IN_SALT', '{{ svc_wordpress_auth_keys.LOGGED_IN_SALT }}');
    define('NONCE_SALT', '{{ svc_wordpress_auth_keys.NONCE_SALT }}');
{% if svc_wordpress_extra_php_ini %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ svc_wordpress_name }}-php-config
data:
  custom.ini: |-
{% for line in svc_wordpress_extra_php_ini.splitlines() %}
    {{ line }}
{% endfor %}
{% endif %}
{% if svc_wordpress_mu_plugins %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ svc_wordpress_name }}-mu-plugins
data:
{% for filename, content in svc_wordpress_mu_plugins.items() %}
  {{ filename }}: |-
{% if content.splitlines() %}
{% for line in content.splitlines() %}
    {{ line }}
{% endfor %}
{% else %}

{% endif %}
{% endfor %}
{% endif %}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ svc_wordpress_name }}
{% if svc_wordpress_service_annotations %}
  annotations:
{% for key, value in svc_wordpress_service_annotations.items() %}
    {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
spec:
  selector:
    app.kubernetes.io/name: {{ svc_wordpress_name }}
  ports:
    - name: http
      port: 80
      targetPort: 80
  type: ClusterIP
{% if svc_wordpress_enable_cron_job %}
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: {{ svc_wordpress_name }}-cron
spec:
  schedule: "{{ svc_wordpress_cron_schedule }}"
  jobTemplate:
    spec:
      activeDeadlineSeconds: {{ svc_wordpress_cron_timeout_seconds }}
      template:
        spec:
          restartPolicy: OnFailure
          containers:
            - name: trigger-wp-cron
              image: {{ svc_wordpress_cron_image }}
              command:
                - /bin/sh
                - -c
                - >-
                  curl --fail --silent --show-error --retry 3 --retry-delay 5 "{{ svc_wordpress_url }}/wp-cron.php?doing_wp_cron=1"
{% endif %}
